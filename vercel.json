{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api"
    },
    {
      "source": "/join/:code",
      "destination": "/index.html"
    },
    {
      "source": "/join/:code/",
      "destination": "/index.html"
    }
  ]
}
